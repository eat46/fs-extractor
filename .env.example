# --- LLM provider（換模型只改這裡）---
LLM_PROVIDER=gemini            # claude | gemini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 抽取行為 ---
# 找不到欄位時一律填 null，不臆造；此門檻僅供人工複檢參考。
CONFIDENCE_THRESHOLD=0.75

# --- 驗證層一致性容忍度（相對營收）---
# 毛利＝營收−成本 是純恆等式 → 收嚴（0.1%）；營業利益＝毛利−營業費用 可能有中間科目
# （其他收益及費損；IFRS 18 接軌後分類更細）→ 留餘裕（2%）。
GROSS_TOLERANCE=0.001
OPERATING_TOLERANCE=0.02

# --- 輸出 ---
OUTPUT_DIR=./_out
